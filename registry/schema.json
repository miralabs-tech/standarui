{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/miralabs-tech/standarui/registry/schema.json",
  "title": "standarui registry",
  "oneOf": [{ "$ref": "#/$defs/item" }, { "$ref": "#/$defs/index" }],
  "$defs": {
    "layer": { "enum": ["core", "react", "styles"] },
    "codeLayer": { "enum": ["core", "react"] },
    "itemType": { "enum": ["registry:nav", "registry:base", "registry:component"] },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "dependencyName": { "type": "string", "pattern": "^(@[a-z][a-z0-9-]*/)?[a-z][a-z0-9-]*$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "path", "sha256", "content"],
      "properties": {
        "layer": { "$ref": "#/$defs/layer" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "content": { "type": "string" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "name", "type", "version", "registryDependencies", "files"],
      "properties": {
        "$schema": { "type": "string" },
        "name": { "$ref": "#/$defs/name" },
        "type": { "$ref": "#/$defs/itemType" },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "dependencies": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "registryDependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dependencyName" }
        },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/file" }
        }
      }
    },
    "specifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "path"],
      "properties": {
        "layer": { "$ref": "#/$defs/codeLayer" },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "indexEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "registryDependencies", "files"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "$ref": "#/$defs/itemType" },
        "registryDependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dependencyName" }
        },
        "files": { "type": "integer", "minimum": 0 }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "name", "version", "manifest", "renames", "specifiers", "items"],
      "properties": {
        "$schema": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "manifest": { "type": "string", "minLength": 1 },
        "renames": { "type": "string", "minLength": 1 },
        "specifiers": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/specifier" }
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/indexEntry" }
        }
      }
    }
  }
}
